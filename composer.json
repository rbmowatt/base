{
    "name": "rbmowatt/base",
    "description": "A set of base components for scaffolding a Laravel REST API: Service, Model, Controller and query-parsing primitives.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "api",
        "rest",
        "scaffolding"
    ],
    "homepage": "https://github.com/rbmowatt/base",
    "authors": [
        {
            "name": "Richard Mowatt",
            "email": "richmowatt@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/rbmowatt/base/issues",
        "source": "https://github.com/rbmowatt/base"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/pagination": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "illuminate/auth": "Required by ApiResponse and BaseApiController to resolve the authenticated user."
    },
    "autoload": {
        "psr-4": {
            "RBMowatt\\Base\\": "src/RBMowatt/Base/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RBMowatt\\BaseTests\\": "tests/",
            "Example\\": "example/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "RBMowatt\\Base\\BaseServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "github-protocols": [
            "https"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
